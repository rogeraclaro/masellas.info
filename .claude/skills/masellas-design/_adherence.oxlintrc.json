{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:agltbook|agltmedium|agltbold|jmtregular))/i]",
        "message": "Font not provided by the design system. Available: agltbook, agltmedium, agltbold, jmtregular."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|mobile|color|as|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: children, mobile, color, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|div)$/]",
        "message": "<Heading> as must be one of 'h1' | 'h2' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Menu'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|mobile|fixed|key|ref|className|style|children)$/]",
        "message": "<Menu> doesn't accept that prop. Declared props: items, active, onSelect, mobile, fixed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Paragraph'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|mobile|style|key|ref|className|style|children)$/]",
        "message": "<Paragraph> doesn't accept that prop. Declared props: children, variant, mobile, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Paragraph'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lead|intro)$/]",
        "message": "<Paragraph> variant must be one of 'lead' | 'intro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|align|height|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: children, tone, align, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|dark)$/]",
        "message": "<Section> tone must be one of 'coral' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Section> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WipeLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|target|tone|strike|flush|key|ref|className|style|children)$/]",
        "message": "<WipeLink> doesn't accept that prop. Declared props: children, href, target, tone, strike, flush."
      },
      {
        "selector": "JSXOpeningElement[name.name='WipeLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|dark)$/]",
        "message": "<WipeLink> tone must be one of 'coral' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Heading": {
        "replaces": []
      },
      "Menu": {
        "replaces": []
      },
      "Paragraph": {
        "replaces": []
      },
      "Section": {
        "replaces": []
      },
      "WipeLink": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--black",
      "--bone",
      "--charcoal",

# Copy to admin/.env (gitignored) or set these in the process environment.
# Values below are the production ones; for local http use COOKIE_SECURE=false, COOKIE_PATH=/, TRUST_PROXY=false.
# Fill ADMIN_PASSWORD_HASH and SESSION_SECRET with: node hash-password.js --env <this file>
# Real environment variables win over values in admin/.env.

# Where to listen. Keep 127.0.0.1 behind a reverse proxy.
PORT=8787
HOST=127.0.0.1

# Private, full data (hidden projects included). Keep it OUTSIDE the web root;
# its .bak and temp files are written next to it.
# Local dev: <repo>/admin/data/projects.json (gitignored).
DATA_FILE=/home/rogermasellas/masellas-admin/data/projects.json

# Public file the site reads, rebuilt after every change and at boot:
# visible projects only, without the visible field. No backup is kept there.
# Local dev: point it at a scratch copy outside the repo (e.g. /tmp/masellas-public/projects/data/projects.json)
# so the committed projects/data/projects.json is never touched.
PUBLIC_FILE=/home/rogermasellas/htdocs/masellas.info/projects/data/projects.json

# Optional: the home's "some words" text is stored next to the files above
# (dirname(DATA_FILE)/some-words.json and dirname(PUBLIC_FILE)/some-words.json).
# Set these only to put it somewhere else (absolute paths).
# SOME_WORDS_FILE=
# SOME_WORDS_PUBLIC_FILE=

# Written by: node hash-password.js --env <file>   (format scrypt$N$r$p$saltHex$hashHex)
ADMIN_PASSWORD_HASH=

# At least 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to false only for local http development.
COOKIE_SECURE=true

# Target of the "view site" link.
PUBLIC_URL=https://masellas.info/projects/

# Session cookie path. /admin/ in production (nginx strips the prefix); / locally.
COOKIE_PATH=/admin/

# true only behind nginx: rate-limit logins by X-Real-IP / X-Forwarded-For.
# Leave false when clients reach the app directly (those headers can be forged).
TRUST_PROXY=true
